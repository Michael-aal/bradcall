# Copy to .env. Never commit real secrets.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
JWT_SECRET="replace-with-a-random-secret-at-least-32-characters-long"
PORT=5000
CORS_ORIGIN="http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,http://127.0.0.1:3000"
# Paystack secret is backend-only; never place it in frontend JavaScript.
PAYSTACK_SECRET_KEY=""
PAYSTACK_CALLBACK_URL="https://your-frontend-domain/payment-result.html"
BRADCALL_COMMISSION_PERCENT=0
# Optional AI moderation. Without a key, the system uses cautious keyword triage.
OPENAI_API_KEY=""
OPENAI_MODERATION_MODEL="gpt-4.1-mini"
ADMIN_NAME="Bradcall Administrator"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-unique-password-at-least-12-characters"
