# Copy to .env. Never commit real secrets.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
JWT_SECRET="replace-with-a-random-secret-at-least-32-characters-long"
PORT=5000
CORS_ORIGIN="http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,http://127.0.0.1:3000"

# Optional MapTiler satellite imagery. Keep the key server-side.
MAPTILER_API_KEY=""

# Paystack: secret stays on the backend. Set the webhook URL in Paystack Dashboard
# to https://YOUR-BACKEND-DOMAIN/api/payments/webhook.
PAYSTACK_SECRET_KEY=""
PAYSTACK_CALLBACK_URL="https://your-frontend-domain/payment-result.html"
BRADCALL_COMMISSION_PERCENT=0

# Optional AI triage for trust reports. Without a key, cautious keyword triage is used.
# Create a key at https://openrouter.ai/keys. Never expose it in frontend code.
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="nvidia/nemotron-3-super-120b-a12b:free"
OPENROUTER_SITE_URL="https://your-frontend-domain"
OPENROUTER_SITE_NAME="Bradcall"

ADMIN_NAME="Bradcall Administrator"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-unique-password-at-least-12-characters"

# Contact verification: configure at least the delivery channel users can select.
RESEND_API_KEY=""
EMAIL_FROM="Bradcall <onboarding@resend.dev>"
TERMII_API_KEY=""
TERMII_SENDER_ID="Bradcall"
TERMII_CHANNEL="generic"
