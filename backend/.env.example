# Copy to .env for local development. Never commit real secrets.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
JWT_SECRET="replace-with-a-random-secret-at-least-32-characters-long"
PORT=5000

# Only used when running: npm run admin:seed
ADMIN_NAME="Bradcall Administrator"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-unique-password-at-least-12-characters"
